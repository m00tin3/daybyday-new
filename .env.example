# ============================================================
# Day-BY-Day 部署环境变量模板
#
# 用法：
#   cp .env.example .env
#   # 修改下面所有密码（务必换成强密码）
#   docker compose up -d --build
#
# .env 已被 .gitignore 排除，不会提交到仓库。
# docker compose 会自动读取同目录下的 .env 文件。
# ============================================================

# ---------- 必填：密码（不设置会直接启动失败）----------

# MySQL root 密码。作为业务库密码使用
MYSQL_PASSWORD=CHANGE_ME_mysql_strong_password

# Redis 访问密码（禁止留空，否则 Redis 等于对容器网络裸奔）
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ---------- 端口 ----------

# 前端主入口端口（默认 80）
WEB_PORT=80

# 前端备用入口端口（默认 8090）
# 国内机房若对 80 端口有拦截策略，可用 http://<IP>:8090 访问
WEB_PORT_ALT=8090

# 后端端口（只绑定 127.0.0.1，供 SSH 隧道调试 Swagger）
BACKEND_PORT=8080

# MySQL / Redis 宿主机端口（只绑定 127.0.0.1，不对外网暴露）
MYSQL_PORT=3306
REDIS_PORT=6379

# ---------- 生产开关 ----------

# 是否关闭 MyBatis SQL 打印（生产建议保持 NoLoggingImpl）
SQL_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

# 后端日志级别（生产建议 info）
LOG_LEVEL=info

# 演示验证码开关：true = 验证码固定 123456（面试演示用）
# 正式运营需改为 false 并接入真实短信服务商
SMS_MOCK=true

# 管理员免验证码登录：true = 管理员账号（role=1）可用任意 6 位验证码登录
# ⚠️ 站点公开可访问时务必改为 false，否则任何知道管理员账号标识的人
#    都能进入 /admin 管理后台删除内容
ADMIN_FREE_LOGIN=true
